# Set at build time; Next.js does not auto-load a file named .env.frontend.
# Use the explicit env-file commands in docs/OPERATIONS.md.
NEXT_PUBLIC_MARKETPLACE_CHAIN_ID=SN_SEPOLIA
NEXT_PUBLIC_MARKETPLACE_ADDRESS=
MARKETPLACE_API_URL=http://127.0.0.1:3100
# Wallet RPC defaults to the owned backend relay. Optional public RPC override:
# NEXT_PUBLIC_STARKNET_RPC_URL=

# Required for production canonical URLs / social metadata:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
