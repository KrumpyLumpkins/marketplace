# Read-only RPC URL; HTTPS is required for mainnet. Never put credentials in plan JSON.
DEPLOYMENT_RPC_URL=
# Optional signer for declare/deploy. Existing funded standard Starknet account only.
DEPLOYMENT_SIGNER_ADDRESS=
DEPLOYMENT_SIGNER_PRIVATE_KEY=
# Alternative trusted local module exporting createAccount({provider,address,chainId}).
# Use this for supported hardware/custom signing. Module code runs locally with your authority.
# DEPLOYMENT_SIGNER_MODULE=/absolute/path/to/approved-signer.mjs
# For the final multisig, export calls and submit through its existing wallet instead.
