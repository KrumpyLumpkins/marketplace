# Copy to .env.backend and supply verified deployment details; no production defaults.
MARKETPLACE_CHAIN=SN_SEPOLIA
MARKETPLACE_RPC_URL=
MARKETPLACE_RPC_FALLBACK_URL=
MARKETPLACE_ADDRESS=
MARKETPLACE_CLASS_HASH=
MARKETPLACE_START_BLOCK=
MARKETPLACE_ORIGIN=http://localhost:3000
# Use an independent random secret; never put this in NEXT_PUBLIC variables.
MARKETPLACE_OPERATOR_TOKEN=
MARKETPLACE_INDEXER_ENABLED=false
MARKETPLACE_API_WORKERS=1
# Use a custom registry for local/devnet deployments.
# MARKETPLACE_REGISTRY_PATH=/app/config/marketplace/registry.json

# Set MARKETPLACE_ORIGIN to the exact HTTPS frontend origin for staging/production.
# Native processes may override MARKETPLACE_DB and MARKETPLACE_ASSET_DIR.
# Compose uses /data; keep those paths on the persistent volume.

# Gateway used to fetch ipfs:// token metadata and media; keep the trailing /ipfs
# path prefix. The public ipfs.io gateway rate limits bulk fetches heavily, so point
# staging/production at a dedicated gateway. Default: https://ipfs.io/ipfs
MARKETPLACE_IPFS_GATEWAY=https://ipfs.io/ipfs
